{
  "name": "bantay-promo",
  "private": true,
  "description": "60-second promotional video for Bantay (vertical and landscape), made with Remotion.",
  "scripts": {
    "studio": "remotion studio",
    "render": "npm run render:vertical && npm run render:landscape",
    "render:vertical": "remotion render BantayPromo out/bantay-promo-vertical.mp4",
    "render:landscape": "remotion render BantayPromoLandscape out/bantay-promo-landscape.mp4",
    "music": "python3 scripts/make-music.py && ffmpeg -y -i public/music.wav -b:a 192k public/music.mp3"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
