{
  "name": "bantay-promo",
  "private": true,
  "description": "Promotional video for Bantay with voice-over (vertical and landscape), made with Remotion.",
  "scripts": {
    "studio": "remotion studio",
    "render": "npm run render:vertical && npm run render:landscape",
    "render:vertical": "remotion render BantayPromo out/bantay-promo-vertical.mp4",
    "render:landscape": "remotion render BantayPromoLandscape out/bantay-promo-landscape.mp4",
    "voice": "python3 scripts/make-voice.py kokoro-v1.0.onnx voices-v1.0.bin"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
